.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
  display: block;
  margin-top: 10rpx;
}

.form {
  padding: 0 40rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  display: block;
  margin-bottom: 20rpx;
}

.required {
  color: var(--danger, #FF6B6B);
}

.optional {
  font-size: 24rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

/* 分类选择 */
.category-list {
  display: flex;
  gap: 20rpx;
}

.category-item {
  flex: 1;
  padding: 24rpx 16rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.category-item.active {
  background: rgba(0, 217, 165, 0.1);
  border-color: var(--accent, #00E5A0);
}

.category-icon {
  font-size: 40rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

.category-item.active .category-name {
  color: var(--accent, #00E5A0);
}

/* 内容输入 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.char-count {
  font-size: 24rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
  text-align: right;
  display: block;
  margin-top: 12rpx;
}

/* 联系方式输入 */
.input {
  width: 100%;
  padding: 24rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--bg-base, #0A0F14);
  font-weight: bold;
  margin-top: 40rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}
