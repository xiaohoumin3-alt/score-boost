/**
 * 家长测评页面样式
 */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 错误提示 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.error-text {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.btn-retry {
  background: #fff;
  color: #764ba2;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 开始页面 */
.start-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.start-header {
  text-align: center;
  margin-bottom: 60rpx;
  margin-top: 100rpx;
}

.start-title {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  margin-bottom: 20rpx;
}

.start-subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

.start-content {
  flex: 1;
}

.start-desc {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.desc-text {
  display: block;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.grade-selector {
  margin-bottom: 40rpx;
}

.grade-label {
  display: block;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.grade-picker {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.grade-value {
  font-size: 28rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.grade-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 科目选择器 */
.subject-selector {
  margin-bottom: 40rpx;
}

.subject-label {
  display: block;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.subject-picker {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.subject-value {
  font-size: 28rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.subject-arrow {
  font-size: 24rpx;
  color: #999;
}

.btn-start {
  background: #fff;
  color: #764ba2;
  padding: 30rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  box-sizing: border-box;
}

.btn-start[disabled] {
  background: rgba(255, 255, 255, 0.5);
  color: rgba(118, 75, 162, 0.5);
}

.start-footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

/* 答题页面 */
.quiz-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  margin-top: 40rpx;
}

.quiz-role {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 32rpx;
  font-weight: bold;
}

.quiz-progress {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.quiz-content {
  flex: 1;
}

.question-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.question-text {
  font-size: 32rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
  line-height: 1.6;
}

.options-list {
  margin-bottom: 40rpx;
}

.option-item {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.option-item.selected {
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(118, 75, 162, 0.3);
}

.option-label {
  width: 60rpx;
  height: 60rpx;
  background: #764ba2;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #4A90D9;
}

.option-text {
  font-size: 28rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
  flex: 1;
}

.quiz-footer {
  padding: 40rpx 0;
}

.btn-next {
  background: #fff;
  color: #764ba2;
  padding: 30rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  box-sizing: border-box;
}

.btn-next[disabled] {
  background: rgba(255, 255, 255, 0.5);
  color: rgba(118, 75, 162, 0.5);
}

/* 家长结果页面 */
.result-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.result-header {
  text-align: center;
  margin-bottom: 60rpx;
  margin-top: 100rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.result-content {
  flex: 1;
}

.result-card {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 60rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.score-number {
  font-size: 64rpx;
  font-weight: bold;
  color: #764ba2;
}

.score-unit {
  font-size: 24rpx;
  color: #764ba2;
}

.score-desc {
  font-size: 28rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.result-message {
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx;
}

.message-text {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
}

.result-footer {
  padding: 40rpx 0;
}

.btn-child {
  background: #fff;
  color: #764ba2;
  padding: 30rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  box-sizing: border-box;
}

/* 对比结果页面 */
.comparison-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.comparison-header {
  text-align: center;
  margin-bottom: 40rpx;
  margin-top: 40rpx;
}

.comparison-title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.comparison-content {
  flex: 1;
}

.score-comparison {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 40rpx;
}

.score-card {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  width: 280rpx;
}

.score-role {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.score-card .score-number {
  font-size: 64rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.score-card .score-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.score-level {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.vs-badge {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vs-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #764ba2;
}

.comparison-message {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.comparison-message .message-text {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
}

.comparison-details {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.detail-value {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  font-weight: bold;
}

.comparison-conclusion {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
}

.conclusion-text {
  font-size: 32rpx;
  color: #764ba2;
  font-weight: bold;
}

.comparison-footer {
  padding: 40rpx 0;
  display: flex;
  gap: 20rpx;
}

.btn-share {
  flex: 1;
  background: #fff;
  color: #764ba2;
  padding: 30rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-restart {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  padding: 30rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 贴图社区区域 */
.tie-zi-community-section {
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
}

.tie-zi-community-section .section-title {
  margin-bottom: 20rpx;
  text-align: center;
}

.tie-zi-community-section .section-title-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.92);
}

.tie-zi-community-section .section-title-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
}

/* 公众号一键发帖区域 */
.share-to-oa-section {
  text-align: center;
  margin-top: 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.btn-post-oa {
  background: linear-gradient(135deg, #00D9A5, #00B386);
  color: #ffffff;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  display: inline-block;
}

.btn-post-oa[disabled] {
  background: rgba(0, 217, 165, 0.4);
  color: rgba(255, 255, 255, 0.6);
}

.post-oa-hint {
  display: block;
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  margin-top: 16rpx;
}

.post-oa-success {
  display: block;
  color: #00D9A5;
  font-size: 24rpx;
  margin-top: 16rpx;
  font-weight: bold;
}

/* Canvas隐藏但可操作 */
.battle-report-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1000px;
}

/* 海报预览浮层 */
.poster-preview {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.poster-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
}

.poster-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 60rpx;
  box-sizing: border-box;
}

.poster-image {
  width: 600rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.5);
}

.poster-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 40rpx;
}

.btn-save-poster {
  background: #00D9A5;
  color: #ffffff;
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-close-poster {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  padding: 20rpx 50rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}
