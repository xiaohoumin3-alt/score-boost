.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
  display: block;
  margin-top: 10rpx;
}

/* Loading */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* Empty State */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--bg-base, #0A0F14);
  font-weight: bold;
}

/* List */
.list {
  padding: 0 40rpx;
}

.feedback-item {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.category-tag.category-bug {
  background: rgba(255, 107, 107, 0.15);
  color: var(--danger, #FF6B6B);
}

.category-tag.category-suggestion {
  background: rgba(0, 217, 165, 0.15);
  color: var(--accent, #00E5A0);
}

.category-tag.category-other {
  background: rgba(102, 126, 234, 0.15);
  color: #667EEA;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tag.status-pending {
  background: rgba(255, 193, 7, 0.15);
  color: #FFC107;
}

.status-tag.status-replied {
  background: rgba(0, 217, 165, 0.15);
  color: var(--accent, #00E5A0);
}

.item-content {
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-text {
  font-size: 24rpx;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.reply-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--danger, #FF6B6B);
}

.reply-badge .dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--danger, #FF6B6B);
  border-radius: 50%;
}
