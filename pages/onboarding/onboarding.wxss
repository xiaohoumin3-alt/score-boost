.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding: 120rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
  margin-top: 16rpx;
}

.form {
  margin-bottom: 60rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  margin-bottom: 20rpx;
}

/* 考试模式选择器 */
.mode-selector {
  display: flex;
  gap: 20rpx;
}

.mode-option {
  flex: 1;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
  text-align: center;
  transition: all 0.3s;
}

.mode-option.active {
  border-color: var(--accent, #00E5A0);
  background: rgba(0, 217, 165, 0.1);
}

.mode-name {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-weight: bold;
  margin-bottom: 8rpx;
}

.mode-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* 标签网格选择器 */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  transition: all 0.2s;
}

.chip.active {
  border-color: var(--accent, #00E5A0);
  background: rgba(0, 217, 165, 0.15);
  color: var(--accent, #00E5A0);
  font-weight: bold;
}

.chip-icon {
  font-size: 32rpx;
}

.confirm-btn {
  background: linear-gradient(135deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  color: var(--bg-base, #0A0F14);
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 28rpx;
  margin-top: 40rpx;
  border: none;
}

.confirm-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
