<view class="page">
  <view class="header">
    <text class="title">欢迎使用提分神器</text>
    <text class="subtitle">先告诉我你的基本情况</text>
  </view>

  <view class="form">
    <!-- 考试模式 -->
    <view class="form-item">
      <text class="label">考试模式</text>
      <view class="mode-selector">
        <view class="mode-option {{examMode === 'grade' ? 'active' : ''}}" bindtap="selectExamMode" data-mode="grade">
          <text class="mode-name">年级测评</text>
          <text class="mode-desc">按年级检测知识点</text>
        </view>
        <view class="mode-option {{examMode === 'huikao' ? 'active' : ''}}" bindtap="selectExamMode" data-mode="huikao">
          <text class="mode-name">会考模拟</text>
          <text class="mode-desc">跨年级综合测评</text>
        </view>
      </view>
    </view>

    <!-- 年级选择（网格标签） -->
    <view class="form-item" wx:if="{{examMode === 'grade'}}">
      <text class="label">选择年级</text>
      <view class="chip-grid">
        <view
          class="chip {{selectedGrade === item ? 'active' : ''}}"
          wx:for="{{availableGrades}}"
          wx:key="*this"
          bindtap="selectGrade"
          data-grade="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
      <text class="hint" wx:if="{{selectedSubject}}">已选科目「{{selectedSubject}}」仅支持以上年级</text>
    </view>

    <!-- 科目选择（网格标签） -->
    <view class="form-item">
      <text class="label">选择科目</text>
      <view class="chip-grid">
        <view
          class="chip {{selectedSubject === item.name ? 'active' : ''}}"
          wx:for="{{examMode === 'huikao' ? huikaoSubjects : availableSubjects}}"
          wx:key="name"
          bindtap="selectSubject"
          data-subject="{{item.name}}">
          <text class="chip-icon">{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <text class="hint" wx:if="{{examMode === 'grade' && selectedGrade}}">已选年级「{{selectedGrade}}」仅支持以上科目</text>
    </view>
  </view>

  <button class="confirm-btn" bindtap="confirm">{{examMode === 'huikao' ? '开始会考模拟' : '开始使用'}}</button>
</view>
