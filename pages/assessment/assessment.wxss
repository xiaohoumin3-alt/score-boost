.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding: 120rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.mode-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 217, 165, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.mode-icon {
  font-size: 24rpx;
}

.mode-text {
  font-size: 24rpx;
  color: var(--accent, #00E5A0);
  font-weight: 500;
}

.question-num {
  font-size: 26rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* Progress Card */
.progress-card {
  margin-bottom: 40rpx;
}

.progress-bar {
  height: 8rpx;
  background: var(--border-subtle, rgba(255, 255, 255, 0.06));
  border-radius: 4rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* Question */
.question-content {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
}

.question-text {
  font-size: 34rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  line-height: 1.6;
}

/* Options */
.options {
  margin-bottom: 40rpx;
}

.option {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
  transition: all 0.2s;
}

.option:active {
  transform: scale(0.98);
}

.option.selected {
  border-color: var(--accent, #00E5A0);
  background: rgba(0, 217, 165, 0.1);
}

.option-key {
  font-size: 28rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
  width: 50rpx;
  flex-shrink: 0;
}

.option-text {
  font-size: 30rpx;
  color: #ddd;
  flex: 1;
}

/* Navigation Buttons */
.nav-buttons {
  display: flex;
  gap: 20rpx;
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
}

.nav-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.nav-prev {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.nav-prev.disabled {
  opacity: 0.4;
}

.nav-next {
  background: linear-gradient(135deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  color: var(--bg-base, #0A0F14);
}

.nav-next.submit {
  background: linear-gradient(135deg, var(--danger, #FF6B6B) 0%, #FF5252 100%);
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

/* Answered State */
.option.answered {
  border-color: #4A90D9 !important;
  background: rgba(74, 144, 217, 0.1) !important;
}