<view class="page">
  <view class="nav-safe-area">
    <text class="nav-title">积分中心</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 当前积分 -->
    <view class="balance-card">
      <text class="balance-label">当前积分</text>
      <text class="balance-value">{{points}}</text>
      <view class="vip-badge" wx:if="{{isVip}}">
        <text class="vip-badge-text">VIP</text>
      </view>
    </view>

    <!-- 积分套餐 -->
    <text class="sec-label">充值套餐</text>
    <view class="plans">
      <view class="plan-card {{selectedPlan.id === item.id ? 'plan-card--active' : ''}} {{item.popular ? 'plan-card--popular' : ''}}"
            wx:for="{{plans}}" wx:key="id"
            bindtap="selectPlan" data-plan="{{item.id}}">
        <view class="plan-popular" wx:if="{{item.popular}}">
          <text class="plan-popular-text">推荐</text>
        </view>
        <text class="plan-name">{{item.name}}</text>
        <text class="plan-price">¥{{item.price}}</text>
        <text class="plan-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- 兑换码 -->
    <text class="sec-label">兑换码</text>
    <view class="redeem-section">
      <input class="redeem-input"
             placeholder="输入兑换码"
             value="{{redeemCode}}"
             bindinput="onRedeemCodeInput"
             maxlength="20" />
      <button class="redeem-btn"
              bindtap="redeemCode"
              disabled="{{redeemLoading || !redeemCode}}">
        {{redeemLoading ? '兑换中...' : '兑换'}}
      </button>
    </view>

    <!-- 积分说明 -->
    <text class="sec-label sec-label--dim">积分规则</text>
    <view class="rules-card">
      <text class="rule-item">注册赠送 100 积分</text>
      <text class="rule-item">每日签到 +10 积分</text>
      <text class="rule-item">邀请好友 +50 积分</text>
      <text class="rule-item">测评消耗 30 积分</text>
      <text class="rule-item">练习消耗 20 积分</text>
      <text class="rule-item">家长测评消耗 50 积分</text>
    </view>
  </block>
</view>
