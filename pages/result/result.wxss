.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding: 120rpx 40rpx 80rpx;
  box-sizing: border-box;
}

/* Perfect Achievement Badge */
.perfect-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  animation: badgePop 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes badgePop {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.badge-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  animation: badgeShine 2s ease-in-out infinite;
}

@keyframes badgeShine {
  0%, 100% {
    transform: rotate(-5deg) scale(1);
    filter: drop-shadow(0 0 10rpx rgba(255, 215, 0, 0.5));
  }
  50% {
    transform: rotate(5deg) scale(1.1);
    filter: drop-shadow(0 0 20rpx rgba(255, 215, 0, 0.8));
  }
}

.badge-text {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #FFD700, #FFA500);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.badge-desc {
  font-size: 28rpx;
  color: var(--accent, #00E5A0);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.label {
  font-size: 32rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

/* Score Ring */
.score-ring-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.score-ring-container.perfect-ring .ring-outer {
  animation: ringPulse 1.5s ease-in-out infinite;
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.3);
}

@keyframes ringPulse {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
  }
  50% {
    box-shadow: 0 0 50rpx rgba(255, 215, 0, 0.6);
  }
}

.score-ring {
  width: 240rpx;
  height: 240rpx;
  position: relative;
}

.ring-outer {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-inner {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--bg-base, #0A0F14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 72rpx;
  font-weight: bold;
  color: var(--accent, #00E5A0);
}

.score-total {
  font-size: 32rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.accuracy-text {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  margin-top: 20rpx;
}

/* ==================== 区域分隔 ==================== */

/* 结果详情区（信息展示） */
.info-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 50rpx;
}

/* 下一步行动区（功能按钮） */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ==================== 信息卡片（阅读型） ==================== */

.info-card {
  background: linear-gradient(135deg, rgba(26, 42, 62, 0.6) 0%, rgba(26, 42, 62, 0.4) 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-title {
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  font-weight: 500;
}

.info-badge {
  font-size: 24rpx;
  font-weight: 600;
}

.info-emoji {
  font-size: 32rpx;
}

.info-body {
  margin-bottom: 12rpx;
}

.info-footer {
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
  padding-top: 12rpx;
}

.info-meta {
  font-size: 22rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.35));
}

/* 预估分数信息卡片 */
.estimated-info .score-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.estimated-info .score-number {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--accent, #00E5A0);
}

.estimated-info .score-number.secondary {
  font-size: 36rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.8));
}

.estimated-info .score-label {
  font-size: 22rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.35));
}

.estimated-info .score-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
}

/* 精度检查信息卡片 */
.accuracy-info .accuracy-bar-bg {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.accuracy-info .accuracy-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.accuracy-info .accuracy-desc {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.6));
}

/* 知识点统计信息卡片 */
.kp-stats-info .kp-stats-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kp-stats-info .kp-stat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.kp-stats-info .kp-stat-name {
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  min-width: 160rpx;
}

.kp-stats-info .kp-stat-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6rpx;
  overflow: hidden;
}

.kp-stats-info .kp-stat-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.kp-stats-info .kp-stat-score {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  min-width: 60rpx;
  text-align: right;
}

/* 复习时间信息卡片 */
.review-info .review-time-text {
  font-size: 28rpx;
  color: var(--purple, #8B5CF6);
  font-weight: 600;
}

/* ==================== 功能按钮（行动型） ==================== */

.action-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, #1a3a2e 0%, #1a2a3e 100%);
  border-radius: 24rpx;
  margin-bottom: 50rpx;
  border: 2rpx solid var(--accent, #00E5A0);
  transition: all 0.3s ease;
}

.action-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 深度测评按钮 */
.action-card.extended-assessment {
  background: linear-gradient(135deg, #1a2a3e 0%, #2a1a3e 100%);
  border: 2rpx solid var(--purple, #8B5CF6);
}

/* 练习按钮 - 主要样式（绿色） */
.action-card.practice-primary {
  background: linear-gradient(135deg, #1a3a2e 0%, #1a2a3e 100%);
  border: 2rpx solid var(--accent, #00E5A0);
}

/* 练习按钮 - 次要样式（灰色） */
.action-card.practice-secondary {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
}

/* 复测状态卡片 */
.action-card.retest-card {
  background: linear-gradient(135deg, #1a2a3e 0%, #2a1a3e 100%);
  border: 2rpx solid var(--purple, #8B5CF6);
}

.action-icon {
  font-size: 48rpx;
}

.action-content {
  flex: 1;
}

.action-label {
  display: block;
  font-size: 34rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-weight: bold;
  margin-bottom: 8rpx;
}

.action-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

/* Buttons */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-row .btn-primary,
.btn-row .btn-secondary {
  flex: 1;
  margin: 0;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  color: var(--bg-base, #0A0F14);
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.btn-secondary:active {
  opacity: 0.8;
}

.btn-secondary.retest-btn {
  background: linear-gradient(135deg, var(--purple, #8B5CF6) 0%, #7C3AED 100%);
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  border: none;
}