.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding: 120rpx 40rpx 80rpx;
  box-sizing: border-box;
}

/* Perfect Achievement Badge */
.perfect-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  animation: badgePop 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes badgePop {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.badge-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  animation: badgeShine 2s ease-in-out infinite;
}

@keyframes badgeShine {
  0%, 100% {
    transform: rotate(-5deg) scale(1);
    filter: drop-shadow(0 0 10rpx rgba(255, 215, 0, 0.5));
  }
  50% {
    transform: rotate(5deg) scale(1.1);
    filter: drop-shadow(0 0 20rpx rgba(255, 215, 0, 0.8));
  }
}

.badge-text {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #FFD700, #FFA500);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.badge-desc {
  font-size: 28rpx;
  color: var(--accent, #00E5A0);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.label {
  font-size: 32rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

/* Score Ring */
.score-ring-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.score-ring-container.perfect-ring .ring-outer {
  animation: ringPulse 1.5s ease-in-out infinite;
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.3);
}

@keyframes ringPulse {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
  }
  50% {
    box-shadow: 0 0 50rpx rgba(255, 215, 0, 0.6);
  }
}

.score-ring {
  width: 240rpx;
  height: 240rpx;
  position: relative;
}

.ring-outer {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-inner {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--bg-base, #0A0F14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 72rpx;
  font-weight: bold;
  color: var(--accent, #00E5A0);
}

.score-total {
  font-size: 32rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.accuracy-text {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  margin-top: 20rpx;
}

/* Action Card */
.action-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, #1a3a2e 0%, #1a2a3e 100%);
  border-radius: 24rpx;
  margin-bottom: 50rpx;
  border: 2rpx solid var(--accent, #00E5A0);
}

.action-card.retest-card {
  background: linear-gradient(135deg, #1a2a3e 0%, #2a1a3e 100%);
  border: 2rpx solid var(--purple, #8B5CF6);
}

.action-icon {
  font-size: 48rpx;
}

.action-content {
  flex: 1;
}

.action-label {
  display: block;
  font-size: 34rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-weight: bold;
  margin-bottom: 8rpx;
}

.action-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

/* Buttons */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-row .btn-primary,
.btn-row .btn-secondary {
  flex: 1;
  margin: 0;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
  color: var(--bg-base, #0A0F14);
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.btn-secondary:active {
  opacity: 0.8;
}

.btn-secondary.retest-btn {
  background: linear-gradient(135deg, var(--purple, #8B5CF6) 0%, #7C3AED 100%);
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  border: none;
}

/* 全分数段难度引导卡片 */
.guidance-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, #1a2a3e 0%, #1a3a2e 100%);
  border-radius: 24rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid var(--accent, #00E5A0);
  animation: guidanceSlide 0.5s ease-out;
}

@keyframes guidanceSlide {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.guidance-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 229, 160, 0.1);
  border-radius: 50%;
}

.icon-emoji {
  font-size: 48rpx;
}

.guidance-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guidance-title {
  font-size: 34rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-weight: bold;
}

.guidance-desc {
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

/* 全分数段引导按钮 */
.btn-guidance {
  width: 100%;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: none;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.btn-guidance:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 提升挑战 - 金橙色，激发成就感 */
.btn-guidance.btn-upgrade {
  background: linear-gradient(135deg, #FFA94D 0%, #FFC107 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 169, 77, 0.4);
}

/* 保持当前 - 绿松石色，肯定当前状态 */
.btn-guidance.btn-maintain {
  background: linear-gradient(135deg, #00D9A5 0%, #00E5A0 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 217, 165, 0.3);
}

/* 降低难度 - 青蓝色，温和引导而非警告 */
.btn-guidance.btn-downgrade {
  background: linear-gradient(135deg, #4A90E2 0%, #5C9BE5 100%);
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

/* Knowledge Points Stats */
.kp-stats {
  background: linear-gradient(135deg, var(--bg-surface, rgba(255, 255, 255, 0.04)) 0%, #1a2a35 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.kp-stats-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  margin-bottom: 24rpx;
}

.kp-stats-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.kp-stat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.kp-stat-name {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  min-width: 200rpx;
}

.kp-stat-bar {
  flex: 1;
  height: 16rpx;
  background: #2a2a4a;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.kp-stat-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.kp-stat-score {
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  min-width: 80rpx;
  text-align: right;
}

/* M6: 复习时间提示 */
.review-tip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #1a2a3e 0%, #2a1a3e 100%);
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid var(--purple, #8B5CF6);
}

.review-icon {
  font-size: 40rpx;
}

.review-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.review-label {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

.review-time {
  font-size: 30rpx;
  color: var(--purple, #8B5CF6);
  font-weight: bold;
}