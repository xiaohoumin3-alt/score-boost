<view class="page">
  <view class="header">
    <text class="label">{{mode === 'assessment' ? '诊断测评完成' : '练习完成'}}</text>
  </view>

  <!-- Perfect Achievement Badge -->
  <view class="perfect-badge" wx:if="{{isPerfect}}">
    <text class="badge-icon">🏆</text>
    <text class="badge-text">完美表现！</text>
    <text class="badge-desc">全部答对，太棒了！</text>
  </view>

  <!-- Score Ring -->
  <view class="score-ring-container {{isPerfect ? 'perfect-ring' : ''}}">
    <view class="score-ring">
      <view class="ring-outer" style="background: conic-gradient(from 0deg, #00D9A5 {{accuracy * 3.6}}deg, #222 {{accuracy * 3.6}}deg);">
        <view class="ring-inner">
          <text class="score-value">{{score}}</text>
          <text class="score-total">/ {{total}}</text>
        </view>
      </view>
    </view>
    <text class="accuracy-text">{{accuracy}}% 正确率</text>
  </view>

  <!-- ==================== 结果详情区（信息展示） ==================== -->
  <view class="info-section">

    <!-- 测评模式信息 -->
    <view wx:if="{{mode === 'assessment'}}">

      <!-- 预估分数卡片（信息展示） -->
      <view class="info-card estimated-info" wx:if="{{estimatedScore !== null}}">
        <view class="info-header">
          <text class="info-title">预估真实分数</text>
          <text class="info-badge" style="color: {{scoreLevel.color}}">{{scoreLevel.emoji}} {{scoreLevel.text}}</text>
        </view>
        <view class="info-body">
          <view class="score-row">
            <text class="score-number">{{estimatedScore}}</text>
            <text class="score-label">平时考试预估</text>
          </view>
          <view class="score-divider"></view>
          <view class="score-row">
            <text class="score-number secondary">{{examScore}}</text>
            <text class="score-label">{{isPrimarySchool ? '期末预估' : '中考预估'}}</text>
          </view>
        </view>
        <view class="info-footer">
          <text class="info-meta">置信度 {{scoreConfidence}}% | 误差 ±{{scoreMargin}}分</text>
        </view>
      </view>

      <!-- 精度检查卡片（信息展示） -->
      <view class="info-card accuracy-info" wx:if="{{currentSE !== null}}">
        <view class="info-header">
          <text class="info-title">测评精度</text>
          <text class="info-badge" style="color: {{accuracyLevel.color}}">{{accuracyLevel.level}}</text>
        </view>
        <view class="info-body">
          <text class="accuracy-desc">{{accuracyLevel.description}} (SE: {{currentSEText}})</text>
          <view class="accuracy-bar-bg">
            <view class="accuracy-bar-fill" style="width: {{accuracyBarWidth}}; background-color: {{accuracyLevel.color}};"></view>
          </view>
        </view>
      </view>

    </view>

    <!-- 练习模式信息 -->
    <view wx:if="{{mode === 'practice'}}">

      <!-- 知识点统计（信息展示） -->
      <view class="info-card kp-stats-info" wx:if="{{kpStats.length > 0}}">
        <view class="info-header">
          <text class="info-title">知识点统计</text>
        </view>
        <view class="info-body">
          <view class="kp-stats-list">
            <view class="kp-stat-item" wx:for="{{kpStats}}" wx:key="kp_id">
              <text class="kp-stat-name">{{item.kp_name}}</text>
              <view class="kp-stat-bar">
                <view class="kp-stat-fill" style="width: {{item.total > 0 ? (item.correct / item.total * 100) : 0}}%; background-color: {{item.total > 0 && item.correct === item.total ? '#00D9A5' : item.correct === 0 ? '#FF6B6B' : '#FFA94D'}};"></view>
              </view>
              <text class="kp-stat-score">{{item.correct}}/{{item.total}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 复习时间提示（信息展示） -->
      <view class="info-card review-info" wx:if="{{showReviewTip}}">
        <view class="info-header">
          <text class="info-title">下次复习</text>
          <text class="info-emoji">📅</text>
        </view>
        <view class="info-body">
          <text class="review-time-text">{{nextReviewText}}</text>
        </view>
      </view>

    </view>

  </view>

  <!-- ==================== 下一步行动区（功能按钮） ==================== -->
  <view class="action-section">

    <!-- 测评模式行动按钮 -->
    <view wx:if="{{mode === 'assessment'}}">

      <!-- 深度测评按钮（功能行动）- 与复测互斥显示，避免"测评"概念重复 -->
      <view class="action-card extended-assessment" wx:if="{{needsExtendedAssessment}}" bindtap="goToExtendedAssessment">
        <text class="action-icon">📊</text>
        <view class="action-content">
          <text class="action-label">继续测评，提升精度</text>
          <text class="action-desc">回答更多问题，获得更精准的学习路径</text>
        </view>
      </view>

      <!-- 开始练习按钮（功能行动） -->
      <view class="action-card {{needsExtendedAssessment ? 'practice-secondary' : 'practice-primary'}}" bindtap="goToPractice">
        <text class="action-icon">{{isPerfect && !needsExtendedAssessment ? '🏆' : '📚'}}</text>
        <view class="action-content">
          <text class="action-label">{{isPerfect && !needsExtendedAssessment ? '测评完成！' : '开始练习'}}</text>
          <text class="action-desc">{{isPerfect && !needsExtendedAssessment ? '继续保持，再接再厉' : needsExtendedAssessment ? '跳过深度测评，直接练习' : '针对薄弱知识点强化训练'}}</text>
        </view>
      </view>

    </view>

    <!-- 练习模式行动按钮 -->
    <view wx:if="{{mode === 'practice'}}">

      <!-- 继续练习按钮（功能行动） -->
      <view class="action-card practice-primary" bindtap="continuePractice">
        <text class="action-icon">🎯</text>
        <view class="action-content">
          <text class="action-label">继续练习</text>
          <text class="action-desc">巩固已掌握的知识点</text>
        </view>
      </view>

      <!-- 返回首页按钮（功能行动） -->
      <view class="action-card practice-secondary" bindtap="goHome">
        <text class="action-icon">🏠</text>
        <view class="action-content">
          <text class="action-label">返回首页</text>
          <text class="action-desc">查看完整学习路径</text>
        </view>
      </view>

    </view>

  </view>

  <!-- Retest Status Card - 与深度测评互斥显示 -->
  <view class="action-card retest-card" wx:if="{{mode === 'assessment' && showRetestCheck && !isPerfect && !needsExtendedAssessment}}">
    <text class="action-icon">{{retestEligible ? '🔄' : '📋'}}</text>
    <view class="action-content">
      <text class="action-label">{{retestEligible ? '调整难度重新测评' : '需要完成练习'}}</text>
      <text class="action-desc">{{retestReason}}</text>
    </view>
  </view>
</view>
