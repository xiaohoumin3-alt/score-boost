.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding-bottom: 180rpx;
}

.debug-section {
  padding: 20rpx;
  background: var(--warning, #FFB84D);
  color: var(--bg-base, #0A0F14);
  margin: 20rpx;
}

.nav-safe-area {
  display: flex;
  align-items: flex-end;
  padding: 0 32rpx 16rpx;
  background: var(--bg-base, #0A0F14);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.header {
  padding: 120rpx 40rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

/* Score Section */
.score-section {
  padding: 40rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 20rpx;
  margin: 20rpx;
}

/* Score Display */
.score-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.score-ring {
  width: 200rpx;
  height: 200rpx;
  position: relative;
}

.ring-outer {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, var(--accent, #00E5A0) 0deg, var(--border-subtle, rgba(255, 255, 255, 0.06)) 0deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg-base, #0A0F14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--accent, #00E5A0);
}

.score-label {
  font-size: 22rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.score-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: var(--accent, #00E5A0);
}

.score-target {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.target-value {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.target-label {
  font-size: 24rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.gap-badge {
  font-size: 22rpx;
  color: var(--danger, #FF6B6B);
  background: rgba(255, 107, 107, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.score-status {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-status.achieved .status-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--accent, #00E5A0);
}

.score-status.achieved .status-detail {
  font-size: 24rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* Section Labels */
.sec-label {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  display: block;
  margin-bottom: 16rpx;
}
.sec-label--accent { color: var(--accent, #00E5A0); }
.sec-label--info { color: var(--info, #5BA3F5); }

/* Path Section */
.path-section {
  padding: 40rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  display: block;
  margin-bottom: 30rpx;
}

.path-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.path-step {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  position: relative;
  padding: 24rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid transparent;
}

.path-step.step-completed {
  border-left-color: var(--accent, #00E5A0);
  opacity: 0.7;
}

.path-step.step-current {
  border-left-color: var(--accent, #00E5A0);
  background: linear-gradient(90deg, rgba(0, 217, 165, 0.15) 0%, var(--bg-surface, rgba(255, 255, 255, 0.04)) 100%);
}

.path-step.step-locked {
  opacity: 0.4;
  border-left-color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.connector {
  position: absolute;
  left: 60rpx;
  top: -20rpx;
  width: 4rpx;
  height: 20rpx;
  background: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.step-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--border-subtle, rgba(255, 255, 255, 0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.step-current .step-icon {
  background: var(--accent, #00E5A0);
  color: var(--bg-base, #0A0F14);
  font-weight: bold;
}

.step-completed .step-icon {
  background: var(--accent, #00E5A0);
  color: var(--bg-base, #0A0F14);
}

.step-locked .step-icon {
  background: var(--border-subtle, rgba(255, 255, 255, 0.06));
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.step-content {
  flex: 1;
}

.step-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.step-name {
  font-size: 30rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-weight: 500;
}

.step-score {
  font-size: 26rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
}

.step-locked .step-score {
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.step-bar {
  height: 8rpx;
  background: var(--border-subtle, rgba(255, 255, 255, 0.06));
  border-radius: 4rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.bar-completed {
  background: var(--accent, #00E5A0);
}

.bar-current {
  background: linear-gradient(90deg, var(--accent, #00E5A0) 0%, var(--accent, #00E5A0) 100%);
}

.bar-locked {
  background: transparent;
}

/* Action Section */
.action-section {
  padding: 0 40rpx 40rpx;
}

.current-card {
  background: linear-gradient(135deg, #1a3a2e 0%, var(--bg-surface, rgba(255, 255, 255, 0.04)) 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 2rpx solid var(--accent, #00E5A0);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-label {
  font-size: 24rpx;
  color: var(--accent, #00E5A0);
}

.card-badge {
  font-size: 20rpx;
  background: var(--accent, #00E5A0);
  color: var(--bg-base, #0A0F14);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.card-title {
  font-size: 36rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  display: block;
  margin-bottom: 24rpx;
}

.card-action {
  background: var(--accent, #00E5A0);
  color: var(--bg-base, #0A0F14);
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* Progress Section */
.progress-section {
  display: flex;
  gap: 4rpx;
  padding: 0 40rpx;
  margin: 16rpx 0;
}

.progress-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 8rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: var(--radius-sm, 12rpx);
}

.progress-item:first-child {
  border-radius: var(--radius-sm, 12rpx) 0 0 var(--radius-sm, 12rpx);
}

.progress-item:last-child {
  border-radius: 0 var(--radius-sm, 12rpx) var(--radius-sm, 12rpx) 0;
}

.progress-value {
  font-size: 34rpx;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
}

.progress-value--accent { color: var(--accent, #00E5A0); }
.progress-value--warning { color: var(--warning, #FFB84D); }
.progress-value--danger { color: var(--danger, #FF6B6B); }

.progress-label {
  font-size: 18rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* Loading */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

/* 个性化学习链路卡片 */
.personalized-section {
  padding: 0 40rpx 40rpx;
}

.chain-card {
  display: flex;
  align-items: stretch;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(91, 163, 245, 0.2);
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
}

.chain-item {
  flex: 1;
  padding: 28rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.chain-icon {
  font-size: 40rpx;
}

.chain-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

.chain-desc {
  font-size: 22rpx;
  color: var(--text-tertiary, rgba(255, 255, 255, 0.25));
}

.chain-arrow {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  font-size: 32rpx;
  color: var(--info, #5BA3F5);
}
/* Empty State */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.empty-action {
  background: var(--accent, #00E5A0);
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
}

.empty-action-text {
  color: var(--bg-base, #0A0F14);
  font-size: 28rpx;
  font-weight: 600;
}

/* Step accuracy label */
.step-accuracy {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  font-variant-numeric: tabular-nums;
}
