<view class="page">
  <view class="nav-safe-area">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-text">‹</text>
    </view>
    <text class="nav-title">错题本</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{grouped.length === 0}}">
    <view class="empty">
      <text class="empty-icon">✅</text>
      <text class="empty-text">{{emptyText}}</text>
    </view>
  </block>

  <block wx:else>
    <view class="summary">
      <text class="summary-text">共 {{grouped.length}} 个知识点有错题</text>
    </view>

    <view class="group" wx:for="{{grouped}}" wx:key="kp_id">
      <view class="group-header">
        <text class="group-kp">{{item.kp_name}}</text>
        <text class="group-count">{{item.mistakes.length}}题</text>
      </view>

      <view class="mistake-item" wx:for="{{item.mistakes}}" wx:for-item="m" wx:key="_id">
        <view class="mistake-question">
          <text class="mistake-text">{{m.question}}</text>
        </view>
        <view class="mistake-options" wx:if="{{m.options}}">
          <text class="mistake-option {{opt === m.correct_answer ? 'correct' : (opt === m.user_answer ? 'wrong' : '')}}"
                wx:for="{{m.options}}" wx:for-item="opt" wx:key="*this">
            {{opt}}
          </text>
        </view>
        <view class="mistake-meta">
          <text class="mistake-date">{{m.created_at}}</text>
        </view>
      </view>

      <view class="retry-btn" bindtap="retryMistake" data-kp-id="{{item.kp_id}}" data-kp-name="{{item.kp_name}}">
        <text class="retry-btn-text">重做这个知识点 ›</text>
      </view>
    </view>
  </block>
</view>
