.page {
  min-height: 100vh;
  background: #0A0F14;
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.section {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.chip.active {
  border-color: #00D9A5;
  background: rgba(0, 217, 165, 0.15);
  color: #00D9A5;
}

.chip-icon {
  font-size: 28rpx;
}

.score-input {
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #fff;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #00D9A5 0%, #00B894 100%);
  color: #0A0F14;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.tips {
  margin-top: 48rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.tip-content {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.6;
  margin-bottom: 8rpx;
}
