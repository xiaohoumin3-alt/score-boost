<view class="page">
  <!-- 自定义导航栏安全区 -->
  <view class="nav-safe-area" style="height: {{navHeight}}rpx;">
    <text class="nav-title">日日守护</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 实时学习动态（替代签到栏） -->
    <view class="live-learning-card" wx:if="{{onlineCount > 0}}" bindtap="goToLiveRanking">
      <view class="live-header">
        <view class="live-left">
          <text class="live-icon">📱</text>
          <text class="live-count-text">正在学习</text>
          <text class="live-count">{{onlineCount}}</text>
          <text class="live-count-text">人</text>
        </view>
        <text class="live-cta">你的孩子开始了吗？</text>
      </view>

      <view class="live-learners">
        <view class="live-learner" wx:for="{{liveLearners}}" wx:key="index">
          <text>{{item.name}}</text>
          <text class="learner-grade">({{item.grade}})</text>
          <text class="learner-kp">{{item.kp}}</text>
        </view>
      </view>
    </view>

    <!-- Score Bar -->
    <view class="score-bar">
      <view class="score-bar-left">
        <text class="score-bar-title">提分神器</text>
        <text class="score-bar-sub">{{subject}} | {{grade}}</text>
      </view>
      <view class="score-bar-right">
        <text class="score-bar-value">{{currentScore}}</text>
        <view class="score-bar-target" wx:if="{{currentScore < targetScore}}">
          <text class="score-bar-tv">{{targetScore}}</text>
          <text class="score-bar-tl">目标</text>
          <text class="score-bar-gap" wx:if="{{totalGap > 0}}">差{{totalGap}}分</text>
        </view>
      </view>
    </view>

    <!-- 今日任务卡片 -->
    <view class="task-card" wx:if="{{todayTask}}" bindtap="startTodayTask">
      <view class="task-header">
        <text class="task-icon">🎯</text>
        <text class="task-title">今日任务</text>
      </view>
      <view class="task-content">
        <text class="task-name">{{todayTask.title}}</text>
        <text class="task-reason" wx:if="{{todayTask.reason}}">{{todayTask.reason}}</text>
      </view>
      <view class="task-footer">
        <text class="task-time">⏱️ 预计{{todayTask.estimated_time || 5}}分钟</text>
        <text class="task-action">开始练习 ›</text>
      </view>
    </view>

    <!-- 重新测评 -->
    <text class="sec-label sec-label--accent">学习闭环</text>
    <view class="loop-card" bindtap="startAssessment">
      <text class="loop-icon">↻</text>
      <view class="loop-body">
        <text class="loop-title">重新测评</text>
        <text class="loop-desc">检验最新学习效果</text>
      </view>
      <text class="loop-arrow">›</text>
    </view>

    <!-- 待复习 -->
    <text class="sec-label sec-label--purple" wx:if="{{hasPendingReviews}}">待复习</text>
    <block wx:if="{{hasPendingReviews}}">
      <view class="review-row" wx:for="{{pendingReviews}}" wx:key="kp_id" bindtap="goReview" data-kp="{{item}}">
        <view class="review-dot"></view>
        <text class="review-kp">{{item.kp_name || item.kp_id}}</text>
        <text class="review-badge" wx:if="{{item.current_difficulty}}">{{item.current_difficulty === 'hard' ? '薄弱' : item.current_difficulty === 'medium' ? '复习' : '巩固'}}</text>
        <text class="review-action">去复习 ›</text>
      </view>
    </block>

    <!-- Recent History -->
    <text class="sec-label sec-label--dim" wx:if="{{recentAssessments.length > 0}}">最近记录</text>
    <view class="history-section" wx:if="{{recentAssessments.length > 0}}">
      <view class="history-list">
        <view wx:for="{{recentAssessments}}" wx:key="assessment_id" class="history-item">
          <text class="history-score">{{item.score_percent || 0}}</text>
          <text class="history-date">{{item.created_at}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
