.page {
  min-height: 100vh;
  background: var(--bg-base, #0A0F14);
  padding-bottom: 180rpx;
}

.nav-safe-area {
  display: flex;
  align-items: flex-end;
  padding: 0 32rpx 16rpx;
  background: var(--bg-base, #0A0F14);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary, #fff);
}

/* Score Bar (matches design spec) */
.score-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border: 1rpx solid var(--border-subtle, rgba(255, 255, 255, 0.06));
  border-radius: var(--radius-md, 20rpx);
  margin: 20rpx 0;
}

.score-bar-left .score-bar-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  color: var(--text-primary, #fff);
}

.score-bar-left .score-bar-sub {
  font-size: 20rpx;
  color: var(--text-tertiary, #666);
  display: block;
  margin-top: 4rpx;
}

.score-bar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.score-bar-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent, #00E5A0);
  font-variant-numeric: tabular-nums;
}

.score-bar-target {
  text-align: right;
}

.score-bar-tv {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
  color: var(--text-primary, #fff);
}

.score-bar-tl {
  font-size: 18rpx;
  color: var(--text-tertiary, #666);
  display: block;
}

.score-bar-gap {
  font-size: 18rpx;
  color: var(--danger, #FF6B6B);
  background: rgba(255, 107, 107, 0.1);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full, 9999rpx);
  display: inline-block;
  margin-top: 4rpx;
}

/* Action Card */
.action-card {
  margin: 0 40rpx 40rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, rgba(0, 229, 160, 0.08), rgba(0, 229, 160, 0.02));
  border-radius: var(--radius-md, 20rpx);
  display: flex;
  align-items: center;
  gap: 30rpx;
  border: 2rpx solid var(--border-accent, rgba(0, 229, 160, 0.3));
}

.action-icon {
  font-size: 56rpx;
}

.action-content {
  flex: 1;
}

.action-label {
  font-size: 36rpx;
  color: var(--text-primary, #fff);
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 26rpx;
  color: var(--text-secondary, #888);
  display: block;
}

.action-arrow {
  font-size: 40rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
}

/* Quick Actions */
.quick-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx 40rpx;
}

.quick-btn {
  flex: 1;
  padding: 24rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: var(--radius-sm, 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quick-icon {
  font-size: 40rpx;
}

.quick-text {
  font-size: 24rpx;
  color: var(--text-secondary, #888);
}

/* Section Labels */
.sec-label {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  display: block;
  margin: 20rpx 40rpx 12rpx;
}
.sec-label--accent { color: var(--accent, #00E5A0); }
.sec-label--purple { color: var(--purple, #8B5CF6); }
.sec-label--dim { color: var(--text-tertiary, #666); }

/* History Section */
.history-section {
  padding: 0 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--text-secondary, #888);
  display: block;
  margin-bottom: 20rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: var(--radius-sm, 12rpx);
}

.history-score {
  font-size: 32rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
}

.history-date {
  font-size: 24rpx;
  color: var(--text-tertiary, #666);
}

/* Loading */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary, #666);
}

/* Feedback Entry */
.feedback-entry {
  margin: 0 40rpx 40rpx;
  padding: 28rpx 32rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.feedback-icon {
  font-size: 36rpx;
}

.feedback-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-secondary, #888);
}

.feedback-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary, #444);
  font-weight: bold;
}

/* 成就展示 */
.achievement-row {
  padding: 0 40rpx 40rpx;
}

.achievement-scroll {
  white-space: nowrap;
}

.achievement-list {
  display: inline-flex;
  gap: 16rpx;
}

.achievement-badge {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #2a2a4a 0%, var(--bg-surface, rgba(255, 255, 255, 0.04)) 100%);
  border-radius: 20rpx;
  border: 2rpx solid var(--border-subtle, #333);
  min-width: 120rpx;
  position: relative;
  overflow: hidden;
}

.achievement-badge::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #FFD700, #FFA500, var(--danger, #FF6B6B), var(--purple, #8B5CF6));
  opacity: 0;
  transition: opacity 0.3s;
}

.achievement-badge.unlocked::before {
  opacity: 1;
}

.badge-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.3));
}

.badge-name {
  font-size: 22rpx;
  color: var(--text-secondary, #888);
  white-space: nowrap;
}

.achievement-badge.unlocked .badge-name {
  color: #FFD700;
  font-weight: bold;
}

/* Review Rows (matches design: individual items, no card wrapper) */
.review-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(139, 92, 246, 0.12);
  border-radius: var(--radius-sm, 12rpx);
  margin: 0 0 12rpx;
}

.review-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--purple, #8B5CF6);
  flex-shrink: 0;
}

.review-kp {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary, #ccc);
}

.review-badge {
  font-size: 20rpx;
  color: var(--purple, #8B5CF6);
  background: rgba(139, 92, 246, 0.1);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full, 9999rpx);
}

.review-action {
  font-size: 22rpx;
  color: var(--purple, #8B5CF6);
  font-weight: 600;
}

/* 连续正确卡片 */
.streak-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 40rpx 40rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #3a2a1a 0%, #2a1a2a 100%);
  border-radius: 20rpx;
  border: 2rpx solid var(--danger, #FF6B6B);
}

.streak-icon {
  font-size: 36rpx;
}

.streak-num {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--danger, #FF6B6B);
}

.streak-label {
  font-size: 24rpx;
  color: var(--text-secondary, #888);
}

/* 进度入口 */
.progress-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 40rpx 20rpx;
  padding: 24rpx;
  background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
}

.entry-icon {
  font-size: 36rpx;
}

.entry-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-secondary, #ccc);
}

.entry-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary, #444);
  font-weight: bold;
}

/* AI今日任务卡片（AI原生Phase 2） */
.task-card {
  margin: 0 40rpx 30rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #1a3a2e 0%, #2a3a2e 100%);
  border-radius: 24rpx;
  border: 2rpx solid var(--accent, #00E5A0);
  box-shadow: 0 8rpx 24rpx rgba(0, 217, 165, 0.15);
}

.task-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.task-icon {
  font-size: 36rpx;
}

.task-title {
  font-size: 32rpx;
  color: var(--text-primary, #fff);
  font-weight: bold;
}

.task-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.task-name {
  font-size: 36rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
}

.task-reason {
  font-size: 24rpx;
  color: var(--text-secondary, #888);
  line-height: 1.5;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-time {
  font-size: 24rpx;
  color: var(--text-tertiary, #666);
}

.task-action {
  font-size: 26rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
}

/* 次要入口 */
.other-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 40rpx 30rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  border: 2rpx dashed var(--text-tertiary, #444);
}

.other-text {
  font-size: 26rpx;
  color: var(--text-secondary, #888);
}

.other-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary, #666);
}

/* Loop Card (重新测评) */
.loop-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 40rpx 30rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(0, 229, 160, 0.06), rgba(0, 229, 160, 0.015));
  border-radius: var(--radius-md, 20rpx);
  border: 2rpx solid var(--border-accent, rgba(0, 229, 160, 0.3));
}

.loop-icon {
  font-size: 40rpx;
  color: var(--accent, #00E5A0);
}

.loop-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loop-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #fff);
}

.loop-desc {
  font-size: 24rpx;
  color: var(--text-secondary, #888);
}

.loop-arrow {
  font-size: 36rpx;
  color: var(--accent, #00E5A0);
}
/* 实时学习动态卡片 */
.live-learning-card {
  margin: 20rpx 40rpx;
  padding: 20rpx 24rpx;
  background: rgba(0, 229, 160, 0.06);
  border: 1rpx solid rgba(0, 229, 160, 0.2);
  border-radius: 16rpx;
}

.live-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.live-left {
  display: flex;
  align-items: center;
}

.live-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.live-count-text {
  font-size: 26rpx;
  color: var(--text-secondary, #888);
}

.live-count {
  font-size: 28rpx;
  color: var(--accent, #00E5A0);
  font-weight: bold;
  margin: 0 4rpx;
}

.live-cta {
  font-size: 24rpx;
  color: var(--accent, #00E5A0);
}

.live-learners {
  display: flex;
  align-items: center;
  gap: 20rpx;
  white-space: nowrap;
  overflow-x: auto;
}

.live-learner {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary, #888);
}

.learner-grade {
  color: var(--text-tertiary, #666);
  font-size: 20rpx;
}

.learner-kp {
  color: var(--text-primary, #fff);
  margin-left: 8rpx;
}
