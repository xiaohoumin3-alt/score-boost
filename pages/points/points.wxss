/**
 * 积分中心页面样式
 */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 积分卡片 */
.points-card {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.points-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.points-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.points-guide {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  text-decoration: underline;
}

.points-value {
  font-size: 96rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  text-align: center;
  margin-bottom: 30rpx;
}

.points-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 签到区域 */
.signin-section {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.signin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.signin-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.signin-streak {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.btn-signin {
  background: #fff;
  color: #764ba2;
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.btn-signin.disabled {
  background: rgba(255, 255, 255, 0.5);
  color: rgba(118, 75, 162, 0.5);
}

.signin-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 邀请好友区域 */
.invite-section {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.invite-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.invite-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.invite-code-box {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.invite-code-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
}

.invite-code-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.code-text {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  letter-spacing: 8rpx;
}

.code-copy {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.3);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.invite-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-invite {
  flex: 1;
  background: #fff;
  color: #764ba2;
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-use-code {
  flex: 1;
  background: rgba(255, 255, 255, 0.3);
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.invite-rewards {
  display: flex;
  justify-content: space-around;
}

.reward-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reward-icon {
  font-size: 32rpx;
}

.reward-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 积分消耗说明 */
.cost-section {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.cost-header {
  margin-bottom: 30rpx;
}

.cost-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.cost-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.cost-item:last-child {
  border-bottom: none;
}

.cost-name {
  font-size: 28rpx;
  color: var(--text-primary, rgba(255, 255, 255, 0.92));
}

.cost-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

/* 邀请码输入弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 80%;
  max-width: 600rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--border-subtle, rgba(255, 255, 255, 0.06));
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx;
}

.modal-body {
  padding: 30rpx;
}

.invite-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 8rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 30rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-cancel {
  color: #999;
  border-right: 1rpx solid #eee;
}

.btn-confirm {
  color: #764ba2;
  font-weight: bold;
}
