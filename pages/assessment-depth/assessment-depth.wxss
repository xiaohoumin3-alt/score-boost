/*assessment-depth.wxss - 深度测评样式*/

.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

/* Loading */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 24rpx;
  color: #666;
  font-size: 28rpx;
}
.queued-state {
  gap: 16rpx;
}
.queued-title {
  margin-top: 24rpx;
  color: #333;
  font-size: 32rpx;
  font-weight: 600;
}
.queued-message {
  margin-top: 0;
}
.queued-tip {
  color: #999;
  font-size: 24rpx;
}

/* Error */
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.error-text {
  color: #f5222d;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.retry-btn {
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 48rpx;
}

/* 精度仪表盘 */
.accuracy-meter {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.meter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.meter-label {
  font-size: 26rpx;
  color: #666;
}
.meter-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
}
.meter-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.meter-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.meter-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}
.meter-status {
  color: #52c41a;
  font-weight: 500;
}

/* 进度信息 */
.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  margin-bottom: 16rpx;
}
.progress-text {
  font-size: 24rpx;
  color: #666;
}
.progress-phase {
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.question-number {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.question-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.option.selected {
  border-color: #1890ff;
  background: #e6f7ff;
}
.option-label {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0f0f0;
  color: #666;
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.option.selected .option-label {
  background: #1890ff;
  color: #fff;
}
.option-text {
  font-size: 28rpx;
  color: #333;
}

/* 建议卡片 */
.recommendation-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #faad14;
}
.rec-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.rec-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.rec-actions {
  display: flex;
  gap: 16rpx;
}
.btn-continue {
  flex: 1;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.btn-finish {
  flex: 1;
  background: #f0f0f0;
  color: #333;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 提交按钮 */
.submit-area {
  padding: 24rpx 0;
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
.submit-btn[disabled] {
  background: #d9d9d9;
}

/* 结果页面 */
.result-page {
  padding: 24rpx 0;
}
.result-header {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: #333;
  margin-bottom: 32rpx;
}
.score-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.score-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}
.score-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #1890ff;
  display: block;
  margin-bottom: 12rpx;
}
.score-se {
  font-size: 24rpx;
  color: #999;
}
.confidence-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ci-label {
  font-size: 26rpx;
  color: #666;
}
.ci-range {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}
.report-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}
.report-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}
.report-item {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.suggestion {
  color: #faad14;
  font-size: 26rpx;
  line-height: 1.6;
}
.btn-home {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
