<!--pages/auto-data-import/auto-data-import.wxml-->
<view class="container">
  <view class="header">
    <text class="title">IRT 数据积累</text>
    <text class="subtitle">踏平等待时间，自动执行</text>
  </view>

  <view class="card">
    <view class="status-row">
      <text class="label">状态:</text>
      <text class="value {{statusClass}}">{{statusText}}</text>
    </view>

    <view class="progress-row" wx:if="{{status === 'running'}}">
      <text class="label">进度:</text>
      <text class="value">{{progress}}%</text>
    </view>

    <view class="message-row">
      <text class="message">{{message}}</text>
    </view>
  </view>

  <view class="card result-card" wx:if="{{result}}">
    <view class="card-title">执行结果</view>
    <view class="result-section">
      <text class="result-title">测评记录:</text>
      <text class="result-text">成功 {{result.assessments.imported}} / {{result.assessments.total}}</text>
      <text class="result-text" wx:if="{{result.assessments.errors > 0}}">失败 {{result.assessments.errors}}</text>
    </view>
    <view class="result-section">
      <text class="result-title">题目统计:</text>
      <text class="result-text">更新 {{result.questionStats.updated}} / {{result.questionStats.total}}</text>
    </view>
  </view>

  <view class="info-card" wx:if="{{status === 'completed'}}">
    <text class="success-icon">✅</text>
    <text class="success-title">数据积累完成</text>
    <text class="success-text">IRT模型已达到"高精度"标准</text>
    <text class="success-text">验收标准已达成</text>
  </view>
</view>

<wxss>
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.status-row, .progress-row, .message-row {
  display: flex;
  margin-bottom: 16rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
}

.value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.value.pending { color: #faad14; }
.value.running { color: #1890ff; }
.value.completed { color: #52c41a; }
.value.error { color: #ff4d4f; }

.message {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.result-card {
  background: #f6ffed;
  border: 2rpx solid #b7eb8f;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.result-section {
  margin-bottom: 24rpx;
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.result-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-left: 24rpx;
}

.info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.success-icon {
  font-size: 120rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.success-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}
</wxss>
