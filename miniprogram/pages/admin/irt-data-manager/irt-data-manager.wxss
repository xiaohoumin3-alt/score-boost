/* pages/admin/irt-data-manager/irt-data-manager.wxss */
.container {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 32rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.action-btn.primary {
  background: #1890ff;
  color: #fff;
}

.action-btn.success {
  background: #52c41a;
  color: #fff;
}

.action-btn:disabled {
  opacity: 0.6;
}

.result {
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  white-space: pre-wrap;
}

.result-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.tips {
  background: #fff7e6;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
}

.tips-text {
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.5;
}
